# Copia a `.env.local` (nunca commitear — `*.local` está en .gitignore).
# Solo variables de scripts locales / frontend público. Sin secretos VITE_.

# Sandbox local (usado por scripts/sandbox-*.mjs vía process.env, no se empaqueta al frontend)
OPEN_SANDBOX_DOMAIN=localhost:8080
OPEN_SANDBOX_API_KEY=cambia-esta-clave
OPEN_SANDBOX_PROTOCOL=http
OPEN_SANDBOX_IMAGE=node:20-slim

# Frontend (opcional): URL del WebSocket del tutor en producción.
# Vacío = ws://localhost:8000/ws/tutor (desarrollo).
# OJO: todo VITE_* queda incrustado en dist/ y es público. Nunca pongas API keys con prefijo VITE_.
# VITE_WS_URL=wss://tu-backend/tutor
