# ============================================================
# Trig AI Tutor — Configuración de entorno
# ============================================================
# Este archivo es la PLANTILLA. Cópialo a `.env` (nunca commitees `.env`).
#
#   cp .env.example .env
#
# Para detectar qué proveedores tienen clave válida y modelo vivo, ejecuta:
#
#   python test_keys.py            # solo diagnostica
#   python test_keys.py --apply    # escribe el ganador en .env
#
# ============================================================

# ─── Proveedor ACTIVO ─────────────────────────────────────────
# El backend usa estas tres variables para todas las llamadas al LLM.
# Cambia OPENAI_BASE_URL según el proveedor que elijas:
#   Groq:        https://api.groq.com/openai/v1
#   OpenAI:      https://api.openai.com/v1
#   DeepSeek:    https://api.deepseek.com
#   NVIDIA:      https://integrate.api.nvidia.com/v1
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Modelo recomendado por proveedor (cuota gratuita / calidad / latencia):
#   Groq:        llama-3.1-8b-instant         ← rápido y con buena cuota free
#   Groq:        llama-3.3-70b-versatile      ← más inteligente, cuota más estricta
#   OpenAI:      gpt-4.1-mini                 ← requiere saldo
#   DeepSeek:    deepseek-chat                ← muy barato
#   NVIDIA:      meta/llama-3.3-70b-instruct  ← modelos rotan, verifica con test_keys
#   Gemini:      gemini-2.0-flash             ← clave empieza con AIza...
#   OpenRouter:  meta-llama/llama-3.1-8b-instruct:free
#   Ollama:      qwen2.5:7b                   ← local, sin cuota, sin internet
MODEL=llama-3.1-8b-instant

# ─── Bóveda de claves (para test_keys.py) ─────────────────────
# test_keys.py lee estas variables para probar TODOS los proveedores
# y elegir el primero que responda. Solo necesitas llenar las que uses.
# Las claves NUNCA se commitean (.gitignore las excluye).

KEY_GROQ=_...
KEY_OPENAI=-...
KEY_DEEPSEEK=-...
KEY_NVIDIA=...
KEY_GEMINI=...
KEY_OPENROUTER=-...

# ─── Backend (opcional) ──────────────────────────────────────
# Puerto del WebSocket FastAPI. Por defecto 8000.
PORT=8000

# Orígenes permitidos para CORS (separados por coma).
# En desarrollo usar "*". En producción, sólo tus dominios.
# Ejemplo: https://mi-app.vercel.app,https://preview.vercel.app
CORS_ORIGINS=*

# Límite de requests por IP por minuto en el WebSocket.
# Protege tu cuota de IA contra abuso.
RATE_LIMIT_PER_MINUTE=10